{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundClear",
  "mainBinaryName": "soundclear",
  "version": "0.1.0",
  "identifier": "dev.soundclear.app",
  "build": {
    "beforeDevCommand": "cd ../.. && npm run dev -w apps/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../.. && npm run build -w apps/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SoundClear",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: data: mediasource: https:; connect-src 'self' ipc: http://ipc.localhost blob: data: https://api-v2.soundcloud.com https://soundcloud.com https://*.sndcdn.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "soundclear"
        ]
      }
    }
  }
}
